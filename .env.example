# LLM Provider (choose one, configure accordingly)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GROQ_API_KEY=your-groq-key-here

# LLM Model selection per agent
ORCHESTRATOR_MODEL=gpt-4o-mini
RED_TEAM_MODEL=gpt-4o-mini
BLUE_TEAM_MODEL=gpt-4o
VERIFIER_LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=./data/veritas.db

# Campaign defaults
DEFAULT_MAX_STEPS=30
DEFAULT_MAX_TOKENS=100000
NORMAL_TASK_ACCURACY_THRESHOLD=0.10
PATCH_REJECTION_MAX=3

# Environment
ENVIRONMENT_TYPE=custom_sut
AGENTDOJO_SUITE=workspace

# Security
SECRET_PATTERNS=["SESSION_TOKEN","API_KEY","PRIVATE_KEY","PASSWORD"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server
API_HOST=0.0.0.0
API_PORT=8000
